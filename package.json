{
  "name": "windfall",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "firebase emulators:start --only auth,firestore",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:emulators": "firebase emulators:exec --only auth,firestore --project windfall-give-bb8b \"npm run seed:emulators && cross-env E2E_EMULATORS=1 playwright test\"",
    "check": "npm run lint && npm run typecheck && npm run test",
    "seed": "tsx scripts/seed-firebase.ts",
    "seed:emulators": "cross-env SEED_EMULATORS=1 tsx scripts/seed-firebase.ts",
    "deploy:firebase": "firebase deploy --only firestore,auth",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "bcryptjs": "^3.0.3",
    "d3-geo": "^3.1.1",
    "firebase-tools": "^15.34.1",
    "gifenc": "^1.0.3",
    "oxlint": "^1.88.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.153.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "description": "Swipe-to-give demo: React SPA on Cloudflare, Firebase Auth + Firestore. All data fictional."
}
