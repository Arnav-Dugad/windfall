# Fonts and portraits have stable URLs: cache for a week, revalidate after.
# Hashed /assets/* files get a one-year immutable cache from worker/assets.js, which also turns a missing
# hash into a 404 (never the SPA's index.html), so that rule can't live here.
/fonts/*
  Cache-Control: public, max-age=604800
  Access-Control-Allow-Origin: *

/people/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
