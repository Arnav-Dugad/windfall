/**
 * Windfall is hosted on Cloudflare as a static-assets Worker (the SPA).
 * Auth, database and live data are Firebase (see firebase.json / firestore.rules).
 * https://developers.cloudflare.com/workers/static-assets/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "windfall",
	"compatibility_date": "2026-10-23",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	}
}
