/**
 * Windfall is hosted on Cloudflare as a static-assets Worker (the SPA). A tiny script (worker/assets.js) runs
 * only for /assets/* to give hashed build files a long immutable cache.
 * Auth, database and live data are Firebase (see firebase.json / firestore.rules).
 * https://developers.cloudflare.com/workers/static-assets/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "windfall",
	"compatibility_date": "2026-10-23",
	"main": "worker/assets.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/assets/*"]
	},
	"observability": {
		"enabled": true
	}
}
